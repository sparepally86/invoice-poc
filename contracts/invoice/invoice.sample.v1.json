    "invoice_after_orchestration": {
      "_description": "RECEIVED invoice after passing through orchestration and workflow agents.",
      "invoice": {
        "identity": {
          "invoice_id": 10001,
          "tenant_id": "tenant-xyz",
          "trace_id": "trace-abc123def456"
        },
        "source": {
          "system": "CAPTURE",
          "source_invoice_ref": "cap-req-20241228-001",
          "received_at": "2024-12-28T10:35:00Z"
        },
        "document": {
          "image_url": "https://storage.example.com/invoices/10001/document.pdf",
          "raw_payload_ref": "blob://storage/invoices/10001/raw.json"
        },
        "header": {
          "invoice_number": "INV-2024-12-001",
          "invoice_date": "2024-12-27",
          "vendor_name": "Acme Corp",
          "vendor_number": "V-12345",
          "currency": "EUR",
          "total_amount": 5250.50
        },
        "lines": [
          {
            "line_number": 1,
            "description": "Consulting services for system design",
            "quantity": 40,
            "unit_price": 125.00,
            "line_amount": 5000.00
          },
          {
            "line_number": 2,
            "description": "Travel expenses",
            "quantity": 1,
            "unit_price": 250.50,
            "line_amount": 250.50
          }
        ],
        "status": "CODED",
        "workflow": {
          "steps": [
            {
              "agent": "validation_agent",
              "action": "validate_invoice",
              "result": {
                "valid": true,
                "checks_passed": [
                  "header_complete",
                  "lines_present",
                  "amounts_consistent"
                ]
              },
              "timestamp": "2024-12-28T10:35:30Z"
            },
            {
              "agent": "matching_agent",
              "action": "match_purchase_order",
              "result": {
                "matched": true,
                "po_number": "PO-2024-0087",
                "variance": 0.0
              },
              "timestamp": "2024-12-28T10:35:45Z"
            },
            {
              "agent": "coding_agent",
              "action": "assign_accounting_codes",
              "result": {
                "coded": true,
                "cost_center": "CC-500",
                "account_code": "6000-001",
                "lines_coded": 2
              },
              "timestamp": "2024-12-28T10:36:00Z"
            }
          ]
        },
        "audit": {
          "created_at": "2024-12-28T10:30:00Z",
          "updated_at": "2024-12-28T10:36:00Z"
        },
        "extensions": {
          "ai": {
            "confidence_scores": {
              "vendor_extraction": 0.98,
              "amount_extraction": 0.99,
              "line_items_extraction": 0.95
            },
            "extracted_by": "ocr_v2.1"
          },
          "analytics": {
            "processing_duration_seconds": 30,
            "agent_timeline": [
              {
                "agent": "validation_agent",
                "duration_ms": 150
              },
              {
                "agent": "matching_agent",
                "duration_ms": 200
              },
              {
                "agent": "coding_agent",
                "duration_ms": 350
              }
            ]
          }
        }
      },
      "_note": "Status has progressed to CODED. Workflow steps track agent execution. Extensions show AI confidence and analytics without polluting the core schema."
    }
  },
  "validation_notes": {
    "draft_requirements": [
      "identity (invoice_id, tenant_id, trace_id)",
      "source (system, received_at)",
      "status = DRAFT",
      "audit (created_at, updated_at)",
      "document, header, and lines are NOT required"
    ],
    "received_requirements": [
      "All DRAFT fields",
      "document with image_url",
      "header with invoice_number, invoice_date, vendor_name, currency, total_amount",
      "lines array with at least 1 entry",
      "status = RECEIVED (or progressed status)",
      "Each line must have: line_number, description, quantity, line_amount"
    ],
    "capture_two_phase_flow": [
      "1. POST /invoices with DRAFT invoice → Returns invoice_id",
      "2. PUT /invoices/{invoice_id} with RECEIVED invoice → Triggers orchestration"
    ],
    "orchestration_trigger": "Orchestrator processes invoice only when status transitions to RECEIVED",
    "workflow_steps": "System records agent execution in workflow.steps. Result objects are agent-specific.",
    "extensions_purpose": "AI confidence, analytics, custom data — does not affect core validation"
  }
}
